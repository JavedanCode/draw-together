<article class="drawing-card">

    <header class="drawing-header">

        <div class="drawing-meta">

            <div class="drawing-user">

                <% if(message.authorId === user.id || user.featuredMember){ %>

                    <span class="username">

                        <%= message.author.username %>

                    </span>

                <% } else { %>

                    <span class="username">

                        Anonymous

                    </span>

                <% } %>

                <% if(message.author.featuredMember){ %>

                    <span class="badge badge-featured">

                        <img
                            src="/icons/glowing-star.svg"
                            class="icon icon-badge"
                            alt=""
                        >

                        Featured

                    </span>

                <% } %>

            </div>

            <p class="drawing-date">

                <% if(message.authorId === user.id || user.featuredMember){ %>

                    <%= message.createdAt.toLocaleDateString() %>

                <% } else { %>

                    Anonymous Artist

                <% } %>

            </p>

        </div>

    </header>

    <div class="drawing-body">

        <img
            src="<%= message.imageData %>"
            alt="Community drawing"
        >

    </div>

    <footer class="drawing-footer">

        <button
            type="button"
            class="like-btn <%= message.likedByCurrentUser ? 'liked' : '' %>"
            data-id="<%= message.id %>"
        >

            <span class="heart">

                <img
                    src="/icons/<%= message.likedByCurrentUser ? 'heart-red.svg' : 'heart-default.svg' %>"
                    class="icon icon-heart icon-theme"
                    alt=""
                >

            </span>

            <span class="like-count">

                <%= message._count.likes %>

            </span>

        </button>

        <% if(user.admin || user.id === message.authorId){ %>

            <div class="drawing-actions">

                <% if(user.id === message.authorId){ %>

                    <a
                        href="/messages/<%= message.id %>/update"
                        class="action-btn"
                    >

                        <img
                            src="/icons/edit.svg"
                            class="icon icon-action icon-theme"
                            alt=""
                        >

                        Edit

                    </a>

                <% } %>

                <form
                    action="/messages/<%= message.id %>/delete"
                    method="POST"
                >

                    <button
                        class="action-btn delete-btn"
                    >

                        <img
                            src="/icons/delete.svg"
                            class="icon icon-action icon-danger"
                            alt=""
                        >

                        Delete

                    </button>

                </form>

            </div>

        <% } %>

    </footer>

</article>