<article class="drawing-card">

    <header class="drawing-header">

        <div class="drawing-author">

            <div class="author-avatar">
                <%= (message.authorId === user.id || message.author.featuredMember)
                    ? message.author.username.charAt(0).toUpperCase()
                    : "?"
                %>
            </div>

            <div>

                <h3>

                    <% if(message.authorId === user.id || message.author.featuredMember){ %>

                        <%= message.author.username %>

                    <% } else { %>

                        Anonymous

                    <% } %>

                </h3>

                <p>

                    <% if(message.authorId === user.id || message.author.featuredMember){ %>

                        <%= message.createdAt.toLocaleString() %>

                    <% } else { %>

                        Anonymous Artist

                    <% } %>

                </p>

            </div>

        </div>

        <% if(message.author.featuredMember){ %>

            <span class="featured-badge">
                ⭐ Featured
            </span>

        <% } %>

    </header>

    <div class="drawing-body">

        <img
            src="<%= message.imageData %>"
            alt="Drawing"
        >

    </div>

    <footer class="drawing-footer">

        <button
            type="button"
            class="like-btn <%= message.likedByCurrentUser ? 'liked' : '' %>"
            data-id="<%= message.id %>"
        >

            <span class="heart">
                <%= message.likedByCurrentUser ? "❤️" : "🤍" %>
            </span>

            <span class="like-count">

                <%= message._count.likes %>

            </span>

        </button>

        <% if(user.admin || user.id === message.authorId){ %>

        <div class="drawing-actions">

            <% if(user.id === message.authorId){ %>

            <a
                href="/messages/<%= message.id %>/update"
                class="action-btn"
            >
                ✏ Edit
            </a>

            <% } %>

            <form
                action="/messages/<%= message.id %>/delete"
                method="POST"
            >

                <button
                    class="action-btn delete-btn"
                >
                    🗑 Delete
                </button>

            </form>

        </div>

        <% } %>

    </footer>

</article>