<header class="navbar">
  <a href="/" class="logo display-font">
    <img
      src="/images/logo-black-white.png"
      alt="Draw Together"
      class="logo-image"
    />

    <span>Draw Together</span>
  </a>

  <nav class="nav-links">
    <a href="/messages/new">
      <img src="/icons/add.svg" class="icon icon-nav" alt="" />

      <span>New Drawing</span>
    </a>

    <a href="/membership">
      <img src="/icons/crown.svg" class="icon icon-nav" alt="" />

      <span>Become a Member</span>
    </a>

    <a href="/user">
      <img src="/icons/profile.svg" class="icon icon-nav" alt="" />

      <span>Profile</span>
    </a>

    <form action="/login/logout" method="POST">
      <button type="submit" class="logout-btn">
        <img src="/icons/logout.svg" class="icon icon-nav" alt="" />

        <span>Logout</span>
      </button>
    </form>

    <button id="themeToggle" class="theme-btn" type="button">
      <img src="/icons/theme-light-dark.svg" class="icon icon-nav" alt="" />

      <span>Dark</span>
    </button>
  </nav>
</header>

<script src="/js/theme.js"></script>
