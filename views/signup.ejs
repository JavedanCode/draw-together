<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %>
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Edu+VIC+WA+NT+Hand&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet" />

    <link rel="stylesheet" href="/css/global.css">

    <link rel="stylesheet" href="/css/icons.css">

    <link rel="stylesheet" href="/css/auth.css">

</head>

<body>

    <main class="auth-page fade-in">

        <section class="auth-hero">

            <h1 class="display-font">

                Join <span>Draw Together</span>

            </h1>

            <p class="auth-tagline">

                Every great drawing starts with a blank canvas.

            </p>

            <p class="text-muted">

                Create your account and start sharing your artwork.

            </p>

        </section>

        <section class="auth-panel">
            <% if (errors && errors.length) { %>
            <div class="form-error">

                <ul>
                    <% errors.forEach(error => { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
                </ul>

            </div>


            
            <% } %>
            <form action="/signup" method="POST" class="auth-form">

                <div class="form-group">

                    <label>Email</label>

                    <input type="email" name="email" autocomplete="email"
                        value="<%= oldInput?.email || '' %>"
                        required>

                </div>

                <div class="form-group">

                    <label>Username</label>

                    <input type="text" name="username" autocomplete="username"
                        value="<%= oldInput?.username || '' %>"
                        required>

                </div>

                <div class="form-group">

                    <label>Password</label>

                    <input type="password" name="password"
                        autocomplete="new-password" required>

                </div>

                <div class="form-group">

                    <label>Confirm Password</label>

                    <input type="password" name="confirmPassword"
                        autocomplete="new-password" required>

                </div>

                <button class="btn btn-primary" type="submit">

                    Create Account

                </button>

            </form>

            <p class="auth-footer">

                Already have an account?

                <a href="/login">

                    Login →

                </a>

            </p>

        </section>

    </main>

</body>

</html>