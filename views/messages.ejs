<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Edu+VIC+WA+NT+Hand&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/icons.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/messages.css">

</head>

<body>

<%- include("partials/navbar") %>

<main class="page fade-in">

<!-- =====================================
     HERO
===================================== -->

<section class="messages-hero">

    <h1 class="display-font">

        My <span>Drawings</span>

    </h1>

    <p class="text-muted">

        You have
        <strong><%= drawings.length %></strong>
        <%= drawings.length === 1 ? "drawing" : "drawings" %>
        in your gallery.

    </p>

</section>

<div class="section-divider"></div>

<!-- =====================================
     ACTIONS
===================================== -->

<section class="gallery-toolbar">

    <a
        href="/messages/new"
        class="btn btn-primary"
    >

        <img
            src="/icons/add.svg"
            class="icon icon-button icon-theme"
            alt=""
        >

        Create Drawing

    </a>

</section>

<div class="section-divider"></div>

<!-- =====================================
     EMPTY
===================================== -->

<% if(drawings.length === 0){ %>

<section class="empty-gallery">

    <img
        src="/icons/paint-pallete.svg"
        class="icon icon-large icon-theme"
        alt=""
    >

    <h2 class="display-font">

        Nothing Here Yet

    </h2>

    <p class="text-muted">

        Your drawings will appear here once you create them.

    </p>

    <a
        href="/messages/new"
        class="btn btn-primary"
    >

        Create Your First Drawing

    </a>

</section>

<% } else { %>

<!-- =====================================
     GALLERY
===================================== -->

<section class="drawing-gallery">

<% drawings.forEach(drawing => { %>

<article class="gallery-card">

    <div class="gallery-image">

        <img
            src="<%= drawing.imageData %>"
            alt="Drawing"
        >

    </div>

    <div class="gallery-info">

        <div>

            <%
                const created = new Date(drawing.createdAt);
                const updated = new Date(drawing.updatedAt);
            %>

            <p class="gallery-date">

                Created

                <%= created.toLocaleDateString() %>

            </p>

            <% if(created.getTime() !== updated.getTime()){ %>

            <p class="gallery-date secondary">

                Updated

                <%= updated.toLocaleDateString() %>

            </p>

            <% } %>

        </div>

        <div class="gallery-actions">

            <a
                href="/messages/<%= drawing.id %>/update"
                class="action-link"
            >

                <img
                    src="/icons/edit.svg"
                    class="icon icon-action icon-theme"
                    alt=""
                >

                Edit

            </a>

            <button
                class="action-link delete-toggle"
                data-target="delete-<%= drawing.id %>"
            >

                <img
                    src="/icons/delete.svg"
                    class="icon icon-action icon-red"
                    alt=""
                >

                Delete

            </button>

        </div>

    </div>

    <div
        class="delete-panel"
        id="delete-<%= drawing.id %>"
    >

        <p>

            Delete this drawing permanently?

        </p>

        <form
            action="/messages/<%= drawing.id %>/delete"
            method="POST"
        >

            <button
                class="btn btn-danger"
                type="submit"
            >

                Delete Forever

            </button>

        </form>

    </div>

</article>

<% }) %>

</section>

<% } %>

</main>

<script src="/js/messages.js"></script>

</body>

</html>