<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= title %></title>

    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/canvas.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>

  <body>
    <%- include("partials/navbar") %>

    <main class="drawing-page">
      <section class="drawing-card">
        <input
          type="hidden"
          id="existingImage"
          value="<%= drawing ? drawing.imageData : '' %>"
        />
        <h1><%= drawing ? "Edit Drawing" : "Create a Drawing" %></h1>

        <form
          action="<%= drawing ? `/messages/${drawing.id}` : '/messages' %>"
          method="POST"
          id="drawingForm"
        >
          <div class="toolbar">
            <div class="toolbar-group">
              <div class="color-tools">
                <button
                  type="button"
                  class="color-swatch active"
                  data-color="#000000"
                  style="background: #000000"
                ></button>

                <button
                  type="button"
                  class="color-swatch"
                  data-color="#ffffff"
                  style="background: #ffffff"
                ></button>

                <button
                  type="button"
                  class="color-swatch"
                  data-color="#ef4444"
                  style="background: #ef4444"
                ></button>

                <button
                  type="button"
                  class="color-swatch"
                  data-color="#f97316"
                  style="background: #f97316"
                ></button>

                <button
                  type="button"
                  class="color-swatch"
                  data-color="#22c55e"
                  style="background: #22c55e"
                ></button>

                <button
                  type="button"
                  class="color-swatch"
                  data-color="#3b82f6"
                  style="background: #3b82f6"
                ></button>

                <label class="custom-color" for="colorPicker"> + </label>

                <input type="color" id="colorPicker" value="#000000" />
              </div>

              <input type="range" id="brushSize" min="1" max="40" value="5" />
              <span id="brushValue">5px</span>
            </div>

            <div class="toolbar-group">
              <button type="button" id="eraserBtn" class="tool-btn">
                Eraser
              </button>

              <button type="button" id="undoBtn" class="tool-btn">Undo</button>

              <button type="button" id="clearBtn" class="tool-btn danger">
                Clear
              </button>
            </div>
          </div>

          <div class="canvas-wrapper">
            <canvas id="drawingCanvas"></canvas>
          </div>

          <input type="hidden" name="imageData" id="imageData" />

          <div class="save-actions">
            <button class="primary-btn save-btn" type="submit">
              <%= drawing ? "Update Drawing" : "Save Drawing" %>
            </button>
          </div>
        </form>
      </section>
    </main>

    <script src="/js/canvas.js"></script>
  </body>
</html>
