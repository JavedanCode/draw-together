<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      href="https://fonts.googleapis.com/css2?family=Edu+VIC+WA+NT+Hand&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/icons.css">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/navbar.css">

</head>

<body>

<%- include("partials/navbar") %>

<main class="profile-page page fade-in">

<!-- =====================================
     HERO
===================================== -->

<section class="profile-hero">

    <h1 class="display-font">

        Your <span>Profile</span>

    </h1>

    <p class="text-muted">

        Manage your Draw Together account.

    </p>

</section>

<div class="section-divider"></div>

<!-- =====================================
     ACCOUNT
===================================== -->

<section>

    <h2 class="section-title">

        Account

    </h2>

    <div class="account-info">

        <div>

            <span class="label">

                Username

            </span>

            <h3>

                <%= user.username %>

            </h3>

        </div>

        <div>

            <span class="label">

                Email

            </span>

            <h3>

                <%= user.email %>

            </h3>

        </div>

        <div>

            <span class="label">

                Status

            </span>

            <h3>

                <% if(user.featuredMember){ %>

                    Featured Artist

                <% }else{ %>

                    Community Member

                <% } %>

            </h3>

        </div>

        <div>

            <span class="label">

                Joined

            </span>

            <h3>

                <%= new Date(user.createdAt).toLocaleDateString() %>

            </h3>

        </div>

    </div>

</section>

<div class="section-divider"></div>

<!-- =====================================
     MY DRAWINGS
===================================== -->

<section class="profile-shortcut">

    <div>

        <h2 class="section-title">

            My Drawings

        </h2>

        <p class="text-muted">

            Manage all your uploaded drawings.

        </p>

    </div>

    <a
        href="/messages/mine"
        class="primary-btn"
    >

        View Gallery

    </a>

</section>

<div class="section-divider"></div>

<!-- =====================================
     SETTINGS
===================================== -->

<section>

    <h2 class="section-title">

        Account Settings

    </h2>

    <!-- USERNAME -->

    <div class="setting">

        <div class="setting-header">

            <div>

                <h3>Username</h3>

                <p><%= user.username %></p>

            </div>

            <button
                class="btn-edit toggle-btn"
                data-target="username-section"
            >
                <img
                    src="/icons/edit.svg"
                    class="icon icon-action icon-theme"
                    alt=""
                >
            </button>

        </div>

        <div
            class="setting-body <%= openSection === 'username' ? 'open' : '' %>"
            id="username-section"
        >

            <form action="/user/update-username" method="POST">

                <input
                    type="text"
                    name="username"
                    value="<%= oldInput?.username || '' %>"
                    placeholder="New username"
                >

                <% const usernameError = errors.find(error => error.path === "username"); %>

                <% if(usernameError){ %>

                    <p class="form-error">

                        <%= usernameError.msg %>

                    </p>

                <% } %>

                <button
                    class="btn btn-primary"
                    type="submit"
                >

                    Save Changes

                </button>

            </form>

        </div>

    </div>

    <!-- EMAIL -->

    <div class="setting">

        <div class="setting-header">

            <div>

                <h3>Email</h3>

                <p><%= user.email %></p>

            </div>

            <button
                class="btn-edit toggle-btn"
                data-target="email-section"
            >
               <img
                            src="/icons/edit.svg"
                            class="icon icon-action icon-theme"
                            alt=""
                        >

            </button>

        </div>

        <div
            class="setting-body <%= openSection === 'email' ? 'open' : '' %>"
            id="email-section"
        >

            <form action="/user/update-email" method="POST">

                <input
                    type="email"
                    name="email"
                    value="<%= oldInput?.email || '' %>"
                    placeholder="New email"
                >

                <% const emailError = errors.find(error => error.path === "email"); %>

                <% if(emailError){ %>

                    <p class="form-error">

                        <%= emailError.msg %>

                    </p>

                <% } %>

                <button
                    class="btn btn-primary"
                    type="submit"
                >

                    Save Changes

                </button>

            </form>

        </div>

    </div>

    <!-- PASSWORD -->

    <div class="setting">

        <div class="setting-header">

            <div>

                <h3>Password</h3>

                <p>••••••••••</p>

            </div>

            <button
                class="btn-edit toggle-btn"
                data-target="password-section"
            >
                <img
                            src="/icons/edit.svg"
                            class="icon icon-action icon-theme"
                            alt=""
                        >

            </button>

        </div>

        <div
            class="setting-body <%= openSection === 'password' ? 'open' : '' %>"
            id="password-section"
        >

            <form action="/user/update-password" method="POST">

                <input
                    type="password"
                    name="password"
                    class="password-input"
                    placeholder="New password"
                >

                <% const passwordError = errors.find(error => error.path === "password"); %>

                <% if(passwordError){ %>

                    <p class="form-error">

                        <%= passwordError.msg %>

                    </p>

                <% } %>

                <input
                    type="password"
                    name="confirmPassword"
                    class="password-input"
                    placeholder="Confirm password"
                >

                <% const confirmError = errors.find(error => error.path === "confirmPassword"); %>

                <% if(confirmError){ %>

                    <p class="form-error">

                        <%= confirmError.msg %>

                    </p>

                <% } %>

                <button
                    type="button"
                    class="btn-edit btn hold-to-show"
                >
                    Hold to reveal
                    <img
                            src="/icons/eye-open.svg"
                            class="icon icon-action icon-theme"
                            alt=""
                        >

                </button>

                <button
                    class="btn btn-primary"
                    type="submit"
                >

                    Save Changes

                </button>

            </form>

        </div>

    </div>

</section>

<div class="section-divider"></div>

<!-- =====================================
     DELETE
===================================== -->

<section class="delete-section">

    <h2 class="section-title">

        Delete Account

    </h2>

    <p class="text-muted">

        This action is permanent and cannot be undone.

    </p>

    <button
        class="btn btn-danger toggle-btn"
        data-target="delete-section"
    >

        Delete Account

    </button>

    <div
        class="setting-body delete-form <%= openSection === 'delete' ? 'open' : '' %>"
        id="delete-section"
    >

        <form
            action="/user/delete"
            method="POST"
        >

            <input
                type="password"
                name="password"
                class="password-input"
                placeholder="Enter password"
            >

            <% const deleteError = errors.find(error => error.path === "deletePassword"); %>

            <% if(deleteError){ %>

                <p class="form-error">

                    <%= deleteError.msg %>

                </p>

            <% } %>

            <label class="checkbox">

                <input
                    type="checkbox"
                    required
                >

                I understand this cannot be undone.

            </label>

            <button
                class="btn btn-danger"
                type="submit"
            >

                Delete Forever

            </button>

        </form>

    </div>

</section>

</main>

<script src="/js/profile.js"></script>

</body>

</html>