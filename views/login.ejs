<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %>
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Edu+VIC+WA+NT+Hand&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet" />

    <link rel="stylesheet" href="/css/global.css">

    <link rel="stylesheet" href="/css/icons.css">

    <link rel="stylesheet" href="/css/auth.css">

</head>

<body>

    <main class="auth-page fade-in">

        <section class="auth-hero">

            <h1 class="display-font">

                Draw <span>Together</span>

            </h1>

            <p class="auth-tagline">

                Draw instead of typing.

            </p>

            <p class="text-muted">

                Create drawings. Share them with the community.
                See what everyone else is making.

            </p>

        </section>

        <section class="auth-panel">
            <% if (error) { %>
            <div class="form-error">
                <%= error %>
            </div>


            
            <% } %>
            <form action="/login" method="POST" class="auth-form">

                <div class="form-group">

                    <label>

                        Username

                    </label>

                    <input type="text" name="username" autocomplete="username"
                        required>

                </div>

                <div class="form-group">

                    <label>

                        Password

                    </label>

                    <input type="password" name="password"
                        autocomplete="current-password" required>

                </div>

                <button class="btn btn-primary" type="submit">

                    Login

                </button>

            </form>

            <p class="auth-footer">

                Don't have an account?

                <a href="/signup">

                    Create one →

                </a>

            </p>

        </section>

    </main>

</body>

</html>