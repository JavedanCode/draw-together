<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %>
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Edu+VIC+WA+NT+Hand&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/icons.css">
    <link rel="stylesheet" href="/css/membership.css">
    <link rel="stylesheet" href="/css/navbar.css">

</head>

<body>
    <%- include("partials/navbar") %>
    <main class="page fade-in">

        <!-- =====================================
     HERO
===================================== -->

        <section class="membership-hero">

            <h1 class="display-font">

                Become <span>Featured</span>

            </h1>

            <p class="text-muted">

                Support Draw Together and showcase your artwork to the
                entire community.

            </p>

        </section>

        <div class="section-divider"></div>

        <!-- =====================================
     BENEFITS
===================================== -->

        <section>

            <h2 class="section-title">

                Why become Featured?

            </h2>

            <div class="benefits-grid">

                <article class="benefit">

                    <img src="/icons/star.svg"
                        class="icon icon-featured icon-theme" alt="">

                    <h3>Featured Gallery</h3>

                    <p>

                        Your drawings appear in the rotating Featured Gallery
                        on the dashboard.

                    </p>

                </article>

                <article class="benefit">

                    <img src="/icons/profile.svg"
                        class="icon icon-featured icon-theme" alt="">

                    <h3>Public Recognition</h3>

                    <p>

                        Your username and publish date become visible on your
                        artwork.

                    </p>

                </article>

                <article class="benefit">

                    <img src="/icons/crown.svg"
                        class="icon icon-featured icon-theme" alt="">

                    <h3>Featured Badge</h3>

                    <p>

                        Receive the Featured Artist badge throughout
                        Draw Together.

                    </p>

                </article>

            </div>

        </section>

        <div class="section-divider"></div>

        <!-- =====================================
     HOW TO JOIN
===================================== -->

        <section class="membership-join">

            <h2 class="section-title">

                How do I become Featured?

            </h2>

            <p class="text-muted">

                Featured access is currently granted manually.

                Send me a message on Discord and I'll send you
                your personal member code.

            </p>

            <div class="discord-box">

                <img src="/icons/discord.svg" class="icon icon-discord " alt="">

                <span>

                    TheGhostIsDead#0234

                </span>

            </div>

        </section>

        <div class="section-divider"></div>

        <!-- =====================================
     ACTIVATE
===================================== -->

        <section class="activate-section">
            <% if (user.featuredMember) { %>
            <div class="already-featured">

                <img src="/icons/glowing-star.svg" class="icon icon-xl" alt="">

                <h2>

                    You're already Featured.

                </h2>

                <p class="text-muted">

                    Thanks for supporting Draw Together.

                </p>

                <a href="/" class="primary-btn">

                    Back to Dashboard

                </a>

            </div>
            <% } else { %>
            <h2 class="section-title">

                Activate your Membership

            </h2>

            <p class="text-muted">

                Enter the member code you received on Discord.

            </p>
            <% if (error) { %>
            <p class="form-error">
                <%= error %>
            </p>


            
            <% } %>
            <form action="/membership" method="POST" class="membership-form">

                <input type="password" name="memberCode"
                    placeholder="Member Code" autocomplete="off"
                    spellcheck="false"
                    value="<%= oldInput.memberCode || '' %>">

                <button class="btn-primary btn" type="submit">

                    Become Featured

                </button>

            </form>


            
            <% } %>
        </section>

    </main>
</body>

</html>